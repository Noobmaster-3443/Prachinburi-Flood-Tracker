# =========================================================================
# Thailand Flood Tracker - Environment Variables Configuration
# =========================================================================

# -------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to browser via NEXT_PUBLIC_*)
# -------------------------------------------------------------------------

# Supabase Project URL (Public)
# Required: Optional (app runs gracefully with LocalStorage if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Public)
# Required: Optional (anon key for client-side queries with strict RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (NEVER prefix with NEXT_PUBLIC_!)
# -------------------------------------------------------------------------

# Admin Dashboard Secret PIN / Passcode (Server-side Only)
# Required: Yes (used by server-side /api/admin/auth endpoint for admin verification)
# Default fallback: 'PrachinAdmin#2026!'
ADMIN_PIN=ChangeThisToAStrongPasscode2026!

# Admin Session JWT / HMAC Signing Secret (Server-side Only)
# Required: Yes (used to sign HMAC tokens for admin session authentication)
ADMIN_JWT_SECRET=super-secret-random-32-character-hmac-key

# Supabase Service Role Key (Server-side Only)
# Required: Optional (used by server-side admin endpoints to bypass RLS for moderation)
SUPABASE_SERVICE_ROLE_KEY=

# GISTDA Disaster API Key (Server-side Only)
# Required: Optional (if provided, fetches live COSMO-SkyMed/Sentinel radar flood extents;
# otherwise serves verified official satellite reference product)
GISTDA_API_KEY=

# Thai Meteorological Department (TMD) API Credentials (Server-side Only)
# Required: Optional (UID and Key from https://data.tmd.go.th/ for severe weather warning feeds)
TMD_API_UID=
TMD_API_KEY=

# Department of Highways (DOH) API URL (Server-side Only)
# Required: Optional (if a machine-readable feed is available; otherwise serves official static alerts)
DOH_API_URL=
